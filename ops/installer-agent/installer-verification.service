[Unit]
Description=Vicrez shop and ownership verification
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/root/installer-operations/agent
ExecStart=/usr/bin/python3 /root/installer-operations/agent/agent.py --live --verification-only
Environment=PYTHONUNBUFFERED=1
UMask=0077
TimeoutStartSec=1800
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/root/installer-operations/agent/state
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M
Nice=10
StandardOutput=journal
StandardError=journal
