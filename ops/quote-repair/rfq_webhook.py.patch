+                 budget_range,preferred_installer_id,notes,source_page,request_id,status,is_b2b,ip_address,user_agent)
+                VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,'legacy_review',0,?,?)""",
+                (submission.full_name,submission.email,submission.phone,submission.vehicle_year,submission.vehicle_make,submission.vehicle_model,
+                 json.dumps(submission.kit_interest),submission.install_timeline,submission.zip_code,submission.budget_range,
+                 submission.preferred_installer_id,submission.notes,submission.source_page,rid,
+                 request.client.host if request.client else 'unknown',request.headers.get('user-agent','')[:500]))
+            sid=cur.lastrowid;duplicate=False
+            conn.execute("""INSERT INTO quote_intake_reviews(submission_id,source,state,reason,payload_hash)
+                VALUES(?,'legacy','held','legacy_consent_and_service_review',?)""",(sid,digest))
+    return JSONResponse({'ok':True,'submission_id':sid,'reference':'VZ-'+str(sid),'request_id':rid,
+        'duplicate':duplicate,'status':'pending_review','routed_to':'staff_review','installers_notified':0,
+        'klaviyo_fired':False,'sms_sent':False,
