+async def submit_rfq(request: Request):
+    """Compatibility intake only. Legacy clients cannot initiate external sends."""
+    from app.routes import directory_rfq, quote_safety
+    from pydantic import ValidationError
+    from uuid import uuid5, NAMESPACE_URL
+    import hashlib
+    raw = await directory_rfq.read_body(request)
+    try:
+        submission = RFQSubmission(**raw)
+    except ValidationError:
+        raise HTTPException(400, "Check your contact, vehicle and installation details.")
+    data = submission.dict(exclude={'hcaptcha_token', 'website_url', 'request_id'})
+    quote_safety.reject_invalid_identity(data)
+    if len(json.dumps(data)) > 12000 or len(submission.kit_interest) > 10 or any(not 1<=len(v)<=80 for v in submission.kit_interest):
+        raise HTTPException(400, "Check the requested work.")
+    encoded = json.dumps(data,sort_keys=True,separators=(',', ':'))
+    digest = hashlib.sha256(encoded.encode()).hexdigest()
+    rid = submission.request_id or str(uuid5(NAMESPACE_URL,'vicrez-legacy-held:'+digest+':'+datetime.utcnow().strftime('%Y-%m-%d')))
+    with directory_rfq.connect() as conn:
+        conn.execute('BEGIN IMMEDIATE')
+        old=conn.execute('SELECT r.id,q.payload_hash FROM rfq_submissions r LEFT JOIN quote_intake_reviews q ON q.submission_id=r.id WHERE r.request_id=?',(rid,)).fetchone()
+        if old:
+            if old['payload_hash']!=digest:raise HTTPException(409,'Request reference already belongs to different or historical details. Use the current directory form.')
+            sid=old['id'];duplicate=True
+        else:
+            quote_safety.rate_limit(conn,data,directory_rfq.secret())
+            cur=conn.execute("""INSERT INTO rfq_submissions
